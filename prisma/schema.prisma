// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SetType {
  NORMAL
  WARMUP
  DROPSET
  FAILURE
  OTHER
}

enum ProgramStatus {
  ACTIVE
  AVAILABLE
  ARCHIVED
}

enum SplitType {
  FULL_BODY
  UPPER_LOWER
  PUSH_PULL_LEGS
  BRO_SPLIT
  HYBRID
  OTHER
}

enum DayType {
  PUSH
  PULL
  LEGS
  UPPER
  LOWER
  FULL_BODY
  SPECIALIZATION
  OTHER
}

model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique
  password        String
  name            String
  birthDate       DateTime?
  height          Float?
  goal            String?
  createdAt       DateTime         @default(now())
  routines        Routine[]
  workoutSessions WorkoutSession[]
  programs        Program[]
}

model Exercise {
  id               Int               @id @default(autoincrement())
  name             String
  muscleGroup      String
  isCustom         Boolean           @default(false)
  equipment        String?
  description      String?
  userId           Int?
  createdAt        DateTime          @default(now())
  routineExercises RoutineExercise[]
  workoutSets      WorkoutSet[]

  @@unique([name, userId])
}

model Program {
  id        Int           @id @default(autoincrement())
  userId    Int
  name      String
  splitType SplitType?
  status    ProgramStatus @default(AVAILABLE)
  startDate DateTime      @default(now())
  endDate   DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id])
  routines  Routine[]
}

model Routine {
  id               Int               @id @default(autoincrement())
  name             String
  description      String?
  type             DayType?
  dayOfWeek        Int?
  userId           Int
  user             User              @relation(fields: [userId], references: [id])
  createdAt        DateTime          @default(now())
  routineExercises RoutineExercise[]
  workoutSessions  WorkoutSession[]
  program          Program           @relation(fields: [programId], references: [id])
  programId        Int
}

model RoutineExercise {
  id          Int      @id @default(autoincrement())
  routineId   Int
  exerciseId  Int
  sets        Int
  repsMin     Int
  repsMax     Int
  order       Int
  notes       String?
  rir         Int?
  restSeconds Int?
  routine     Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise    Exercise @relation(fields: [exerciseId], references: [id])
}

model WorkoutSession {
  id          Int          @id @default(autoincrement())
  userId      Int
  routineId   Int?
  startTime   DateTime     @default(now())
  endTime     DateTime?
  isCompleted Boolean      @default(false)
  notes       String?
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id])
  routine     Routine?     @relation(fields: [routineId], references: [id])
  workoutSets WorkoutSet[]
}

model WorkoutSet {
  id          Int            @id @default(autoincrement())
  sessionId   Int
  exerciseId  Int
  order       Int
  weight      Float? //kilograms
  reps        Int
  rir         Int?
  setType     SetType        @default(NORMAL)
  isCompleted Boolean        @default(false)
  notes       String?
  session     WorkoutSession @relation(fields: [sessionId], references: [id])
  exercise    Exercise       @relation(fields: [exerciseId], references: [id])
}
